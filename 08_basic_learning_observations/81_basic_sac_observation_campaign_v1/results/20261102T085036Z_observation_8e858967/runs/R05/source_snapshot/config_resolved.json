{
  "learner": {
    "version": "81_basic_sac_observation_campaign_v1",
    "seed": 901,
    "device": "cuda",
    "torch_threads": 1,
    "deterministic_torch": true,
    "episode_steps": 500,
    "reward_function_version": "v2",
    "buffer_size": 100000,
    "batch_size": 256,
    "learning_starts": 1000,
    "learning_rate": 0.0003,
    "gamma": 0.99,
    "tau": 0.005,
    "net_arch": [
      256,
      256
    ],
    "n_critics": 2,
    "ent_coef": "auto",
    "target_entropy": "auto",
    "target_update_interval": 1,
    "train_freq": 1,
    "gradient_steps": 1,
    "normalize_observations": false,
    "normalize_rewards": false,
    "use_sde": false,
    "action_noise": null,
    "optimize_memory_usage": false,
    "handle_timeout_termination": true,
    "n_steps": 1,
    "smoke_train_steps": 4000,
    "resume_steps": 1000,
    "validation_eval_episodes_per_task": 2,
    "diagnostic_bank_episodes_per_task": 2,
    "outcome_bank_episodes_per_task": 100,
    "bank_seed": 95001,
    "log_every_steps": 250,
    "resume_atol": 0.0,
    "resume_rtol": 0.0
  },
  "suite": "B",
  "task_mapping": {
    "labels": [
      "DO",
      "DC",
      "PU",
      "BP"
    ],
    "envs": [
      "drawer-open-v3",
      "drawer-close-v3",
      "push-v3",
      "button-press-v3"
    ]
  },
  "normalization": "no observation/reward normalization; raw 39D float64 -> policy 39D float32 plus task one-hot",
  "schedule_depends_on_total_length": false,
  "learning_rate_schedule": "constant 0.0003",
  "original_p0_length": 400000,
  "this_campaign_length": 1000000,
  "autoreset": "none; fresh environment each episode; no ignored action/reset calls counted as transitions",
  "bootstrap": "terminated masks target; 500-step timeout does not mask target; SB3 timeout correction unchanged",
  "policy": "shared task-conditioned MLP across tasks; separate actor and double critic networks; 256/256 ReLU, no task-specific heads",
  "reward_version": "v2",
  "environment_version": "v3",
  "wrappers": "none for real collector; PolicySpaces only for SAC constructor",
  "n_envs": 1,
  "evaluation_terminal_rule": "native termination/truncation, no success-only stop"
}
